[32m+[m[32m        lstm_weights = [self.model.weights[1].numpy().astype(dtype), self.model.weights[2].numpy().astype(dtype),[m
[32m+[m[32m                        self.model.weights[3].numpy().astype(dtype)][m
[32m+[m[32m        c_fw = np.zeros([1, self.hunits], dtype=dtype)[m
