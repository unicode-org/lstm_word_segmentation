[32m+[m[32m        all_h_fw = np.zeros([len(test_input), self.hunits], dtype=dtype)[m
[32m+[m[32m        for i in range(len(test_input)):[m
[32m+[m[32m            x_t = None[m
[32m+[m[32m            if self.embedding_type == "grapheme_clusters_tf":[m
