[32m+[m[32mimport h5py[m
[32m+[m
[32m+[m[32mdef convert_to_numpy(value):[m
[32m+[m[32m    """[m
[32m+[m[32m    Convert TensorFlow tensors/variables to NumPy arrays (float32).[m
[32m+[m[32m    Ensures we remove any TensorFlow-specific data.[m
[32m+[m[32m    """[m
[32m+[m[32m    if isinstance(value, tf.Tensor) or isinstance(value, tf.Variable):[m
[32m+[m[32m        return value.numpy().astype(np.float32)[m
[32m+[m[32m    elif isinstance(value, np.ndarray) and np.issubdtype(value.dtype, np.number):[m
[32m+[m[32m        return value.astype(np.float32)[m
[32m+[m[32m    else:[m
[32m+[m[32m        return None  # Ignore non-numeric data[m
[32m+[m
[32m+[m[32mdef convert_weights(npy_path):[m
[32m+[m[32m    """Convert `weights.npy` to a TensorFlow-free HDF5 format."""[m
[32m+[m[32m    if not os.path.exists(npy_path):[m
[32m+[m[32m        print(f"❌ Error: {npy_path} not found!")[m
[32m+[m[32m        return[m
[32m+[m[41m    [m
[32m+[m[32m    h5_path = npy_path.replace(".npy", "_tf_free.h5")[m
[32m+[m[41m    [m
[32m+[m[32m    # Load the weights[m
[32m+[m[32m    print(f"🔍 Loading {npy_path}...")[m
[32m+[m[32m    weights = np.load(npy_path, allow_pickle=True)[m
[32m+[m
[32m+[m[32m    # Convert all elements to NumPy arrays (remove TensorFlow dtypes)[m
[32m+[m[32m    converted_weights = [convert_to_numpy(w) for w in weights if convert_to_numpy(w) is not None][m
[32m+[m
[32m+[m[32m    # Save to HDF5 format[m
[32m+[m[32m    with h5py.File(h5_path, "w") as hf:[m
[32m+[m[32m        for i, w in enumerate(converted_weights):[m
[32m+[m[32m            hf.create_dataset(f"weight_{i}", data=w)[m
[32m+[m
[32m+[m[32m    print(f"✅ Converted: {npy_path} -> {h5_path}")[m
[32m+[m
[32m+[m[32mif __name__ == "__main__":[m
[32m+[m[32m    # Search for all `weights.npy` files and convert them[m
