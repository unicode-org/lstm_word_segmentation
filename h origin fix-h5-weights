[32m+[m[32m                x_t = embedarr[input_codepoint_id, :][m
[32m+[m[32m                x_t = x_t.reshape(1, x_t.shape[0])[m
[32m+[m[32m            else:[m
[32m+[m[32m                print("Warning: this embedding type is not implemented for manual prediction")[m
