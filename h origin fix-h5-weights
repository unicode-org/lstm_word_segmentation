[32m+[m[32mdef get_segmented_file_in_one_line(filename, input_type, output_type):[m
[32m+[m[32m    """[m
[32m+[m[32m    This function returns a single segmented line that contains all lines in a text file. If the output is supposed to[m
[32m+[m[32m    be manually segmented, it just combines the manually segmented sentences inside the file. If the output is supposed[m
[32m+[m[32m    to be icu segmented, it first combines all unsegmented versions of line of the text into a single line, and then use[m
[32m+[m[32m    icu to segment that single line.[m
[32m+[m[32m    The reason for this function is that some code points at the beginning of lines in some Burmese texts are not[m
[32m+[m[32m    valid code points and need to be merged with previous line (see line 457457 of the my_train.txt).[m
[32m+[m[32m    Args:[m
[32m+[m[32m        filename: address of the input file[m
[32m+[m[32m        input_type: determines if the input is unsegmented, manually segmented, or ICU segmented[m
[32m+[m[32m        output_type: determines if the output is manually segmented or ICU segmented[m
[32m+[m[32m    """[m
[32m+[m[32m    lines = get_lines_of_text(filename, input_type)[m
[32m+[m[32m    all_file_line = ""[m
[32m+[m[32m    if output_type == "man_segmented":[m
[32m+[m[32m        for i in range(len(lines)):[m
[32m+[m[32m            all_file_line += lines[i].man_segmented[m
[32m+[m[32m            if i != len(lines) - 1:[m
[32m+[m[32m                all_file_line += " "[m
[32m+[m[32m        return all_file_line[m
[32m+[m[32m    if output_type == "icu_segmented":[m
[32m+[m[32m        for i in range(len(lines)):[m
[32m+[m[32m            all_file_line += lines[i].unsegmented[m
[32m+[m[32m            if i != len(lines)-1:[m
[32m+[m[32m                all_file_line += " "[m
[32m+[m[32m        all_file_line = Line(all_file_line, "unsegmented")[m
[32m+[m[32m        return all_file_line.icu_segmented[m
