[32m+[m[32m                input_graph_id = test_input[i].graph_clust_id[m
[32m+[m[32m                x_t = embedarr[input_graph_id, :][m
[32m+[m[32m                x_t = x_t.reshape(1, x_t.shape[0])[m
[32m+[m[32m            elif self.embedding_type == "grapheme_clusters_man":[m
[32m+[m[32m                input_graph_vec = test_input[i].graph_clust_vec[m
[32m+[m[32m                x_t = input_graph_vec.dot(embedarr)[m
[32m+[m[32m            elif self.embedding_type == "generalized_vectors":[m
[32m+[m[32m                input_generalized_vec = test_input[i].generalized_vec[m
[32m+[m[32m                x_t = input_generalized_vec.dot(embedarr)[m
[32m+[m[32m            elif self.embedding_type == "codepoints":[m
[32m+[m[32m                input_codepoint_id = test_input[i].codepoint_id[m
[32m+[m[32m                x_t = embedarr[input_codepoint_id, :][m
