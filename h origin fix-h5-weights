[32m+[m[32mdef permute_lines_of_text(filename, permutated_filename):[m
[32m+[m[32m    """[m
[32m+[m[32m    This function first divides line of an input file into buckets where each bucket is a fixed number of successive[m
[32m+[m[32m    lines in the file, and then write down these buckets of lines into a new file randomely (without repetition).[m
[32m+[m[32m    Args:[m
[32m+[m[32m        filename: the input file[m
[32m+[m[32m        permutated_filename: the output file[m
[32m+[m[32m    """[m
[32m+[m[32m    num_lines = sum(1 for _line in open(filename))[m
[32m+[m[32m    bucket_size = 20[m
[32m+[m[32m    permutated_buckets = np.random.permutation(num_lines//bucket_size)[m
[32m+[m[32m    new_file = open(permutated_filename, 'w')[m
[32m+[m[32m    lines_list = [line for line in open(filename)][m
[32m+[m[32m    for bucket_id in permutated_buckets:[m
[32m+[m[32m        for line in lines_list[bucket_id*bucket_size: (bucket_id+1)*bucket_size]:[m
[32m+[m[32m            new_file.write(line)[m
