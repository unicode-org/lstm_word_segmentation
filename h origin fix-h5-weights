[32m+[m[32m                        self.model.weights[6].numpy().astype(dtype)][m
[32m+[m[32m        c_bw = np.zeros([1, self.hunits], dtype=dtype)[m
[32m+[m[32m        h_bw = np.zeros([1, self.hunits], dtype=dtype)[m
[32m+[m[32m        all_h_bw = np.zeros([len(test_input), self.hunits])[m
[32m+[m[32m        for i in range(len(test_input) - 1, -1, -1):[m
[32m+[m[32m            x_t = None[m
