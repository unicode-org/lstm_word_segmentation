[32m+[m[32m            line += "|"[m
[32m+[m
[32m+[m[32m        # Adding "|" to the start of each line if it is not there[m
[32m+[m[32m        if len(line) >= 0 and line[0] != '|':[m
[32m+[m[32m            line = '|' + line[m
[32m+[m
[32m+[m[32m    return line[m
