[32m+[m[32mdef divide_train_test_data(input_text, train_text, valid_text, test_text, line_limit):[m
[32m+[m[32m    """[m
[32m+[m[32m    This function divides a file into three new files, that contain train data, validation data, and test data[m
[32m+[m[32m    It first divide lines of the text into small buckets (e.g. 20 lines per each bucket) and then distribute each[m
[32m+[m[32m    bucket between train, validation and test texts. This way, we will in each of the resulting texts, we have samples[m
[32m+[m[32m    from all ovor the original text.[m
[32m+[m[32m    Args:[m
[32m+[m[32m        input_text: address of the original file[m
[32m+[m[32m        train_text: address to store the train data in it[m
[32m+[m[32m        valid_text: address to store the validation data in it[m
[32m+[m[32m        test_text: address to store the test file in it[m
[32m+[m[32m        line_limit: the number of lines that we want to process[m
[32m+[m[32m    """[m
[32m+[m[32m    train_ratio = 0.4[m
[32m+[m[32m    valid_ratio = 0.4[m
[32m+[m[32m    bucket_size = 20[m
[32m+[m[32m    train_file = open(train_text, 'w')[m
[32m+[m[32m    valid_file = open(valid_text, 'w')[m
[32m+[m[32m    test_file = open(test_text, 'w')[m
[32m+[m[32m    line_counter = 0[m
[32m+[m[32m    with open(input_text) as f:[m
[32m+[m[32m        for line in f:[m
[32m+[m[32m            if line_counter > line_limit:[m
[32m+[m[32m                break[m
[32m+[m[32m            line_counter += 1[m
[32m+[m[32m            line = line.strip()[m
[32m+[m[32m            if is_ascii(line):[m
[32m+[m[32m                continue[m
[32m+[m[32m            if line_counter % bucket_size <= bucket_size*train_ratio:[m
[32m+[m[32m                train_file.write(line + "\n")[m
[32m+[m[32m            elif bucket_size*train_ratio < line_counter % bucket_size <= bucket_size*(train_ratio+valid_ratio):[m
[32m+[m[32m                valid_file.write(line + "\n")[m
[32m+[m[32m            else:[m
[32m+[m[32m                test_file.write(line + "\n")[m
