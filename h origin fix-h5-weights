[32m+[m[32m# Function normalize_string is written with the goal of increasing accuracy for grapheme cluster based models. In the[m
[32m+[m[32m# current implementation we don't use it, but we don't delete it as it may be used later.[m
[32m+[m[32mdef normalize_string(in_str, allowed_scripts):[m
[32m+[m[32m    """[m
[32m+[m[32m    Normalizes in_str by replacing letters and digits in other scripts with[m
[32m+[m[32m    exemplar values.[m
[32m+[m
[32m+[m[32m    Args:[m
[32m+[m[32m        in_str: String to process[m
[32m+[m[32m        allowed_scripts: List of script short names (like "Mymr") to preserve[m
[32m+[m[32m    """[m
[32m+[m[32m    # TODO: Consider checking ScriptExtensions here as well[m
[32m+[m[32m    output = ""[m
[32m+[m[32m    for ch in in_str:[m
[32m+[m[32m        ch_script = Script.getScript(ch)[m
[32m+[m[32m        ch_type = Char.charType(ch)[m
[32m+[m[32m        ch_bucket = constants.CHAR_TYPE_TO_BUCKET[ch_type][m
[32m+[m[32m        ch_digit = Char.digit(ch)[m
[32m+[m[32m        if ch_script.getShortName() in allowed_scripts:[m
[32m+[m[32m            # ch is in an allowed script:[m
[32m+[m[32m            # copy directly to the output[m
[32m+[m[32m            output += ch[m
[32m+[m[32m        elif ch_bucket == 1:[m
[32m+[m[32m            # ch is a letter in a disallowed script:[m
[32m+[m[32m            # normalize to the sample char for that script[m
[32m+[m[32m            output += Script.getSampleString(ch_script)[m
[32m+[m[32m        elif ch_bucket == 3 and ch_digit != -1:[m
[32m+[m[32m            # ch is a decimal digit in a disallowed script:[m
[32m+[m[32m            # normalize to the zero digit in that numbering system[m
[32m+[m[32m            output += chr(ord(ch) - ch_digit)[m
[32m+[m[32m        elif ch_type == UCharCategory.CURRENCY_SYMBOL:[m
[32m+[m[32m            # ch is a currency symbol in a disallowed script:[m
[32m+[m[32m            # normalize to $[m
[32m+[m[32m            output += "$"[m
[32m+[m[32m        else:[m
[32m+[m[32m            # all other characters:[m
[32m+[m[32m            # copy directly to the output[m
[32m+[m[32m            output += ch[m
[32m+[m[32m    return output[m
